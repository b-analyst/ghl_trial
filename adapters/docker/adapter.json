{
  "container_runtime": "docker",
  "timeouts": {
    "startup_s": 120,
    "setup_s": 300,
    "tool_use_s": 300,
    "grading_s": 600
  },
  "execution": {
    "output_directory": "/workdir",
    "network": false
  },
  "artifact_shape": {
    "grader_entrypoint": "/opt/settlement-ci/harness/grader.py",
    "file_modes": {
      "/opt/settlement-ci/harness": "700"
    }
  }
}
