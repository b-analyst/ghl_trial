# Shell scripts run under dash inside the image. With core.autocrlf=true on
# Windows, a checkout rewrites them to CRLF and the build dies on
# `set: Illegal option -`, which is how the first build of this scaffold failed.
*.sh text eol=lf

# Staged into the sandbox and read by the agent; keep them byte-stable so
# fixture history stays reproducible across platforms.
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf

# Eval logs are zip archives, not text.
*.eval binary
