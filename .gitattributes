# These run inside the Linux container. A Windows checkout that converts them
# to CRLF makes the build fail with "/bin/sh^M: bad interpreter", which is a
# confusing error a long way from its cause. Pin them to LF everywhere.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.py            text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.cmd           text eol=crlf
